    TEMPLATE ||--o{ SCENE_CREATURE_LOG : "creature"

    CAMPAIGN {
        uuid id PK "schema public (catalog)"
        text name
        text schema_name "one schema per campaign"
    }
    STAT_DEFINITION {
        uuid id PK
        text name "e.g. str, luck; unique"
        text description
    }
    DICE_THROW {
        uuid id PK
        text formula "e.g. 2d8 + str"
    }
    ABILITY {
        uuid id PK
        text name
        text description
        jsonb effects "conditions, duration, charges, uses per rest"
        bool created_by_ai
    }
    ABILITY_THROW {
        uuid ability_id PK,FK
        text name PK "e.g. success, height"
        uuid dice_throw_id FK
    }
    TEMPLATE {
        uuid id PK
        text kind "race | class | creature"
        text name
        jsonb stat_modifiers "race/class: {dex: +2}"
        jsonb base_stats "creature: starting stats"
    }
    TEMPLATE_ABILITY {
        uuid template_id PK,FK
        uuid ability_id PK,FK
    }
    CHARACTER {
        uuid id PK
        text kind "player | npc | tc"
        text name "NPC: unique"
        text handle "TC: e.g. wolf_01, unique per encounter"
        uuid creature_id FK "TC only"
        uuid encounter_id FK "TC only"
        uuid location_id FK
        jsonb stats "{str: 14, luck: 3, hp: 20}"
    }
    CHARACTER_TEMPLATE {
        uuid character_id PK,FK
        uuid template_id PK,FK
    }
    CHARACTER_ABILITY {
        uuid character_id PK,FK
        uuid ability_id PK,FK
        text origin "race | class | acquired | creature"
        int uses_left
    }
    CONDITION {
        uuid id PK
        uuid character_id FK
        text name
        text source_kind "ability | item | character"
        uuid source_id
        text duration_kind "rounds | rest | permanent"
        int duration_left
        jsonb effect "stat modifiers, advantage/disadvantage"
    }
    ITEM_TEMPLATE {
        uuid id PK
        text name
        text description
    }
    ITEM_INSTANCE {
        uuid id PK
        uuid template_id FK
        uuid owner_id FK "character, optional"
        uuid location_id FK "optional"
        text custom_name
        int quantity
        int charges
        text item_condition
    }
    MODE {
        uuid id PK
        uuid item_template_id FK "either"
        uuid item_instance_id FK "or"
        text name "e.g. two_handed"
    }
    MODE_THROW {
        uuid mode_id PK,FK
        text name PK "to_hit, damage"
        uuid dice_throw_id FK
    }
    ITEM_INSTANCE_ABILITY {
        uuid item_instance_id PK,FK
        uuid ability_id PK,FK
    }
    LOCATION {
        uuid id PK
        uuid parent_id FK
        text name
        text description
        text notes
    }
    QUEST {
        uuid id PK
        uuid parent_id FK
        text title
        text description
        text status "open | active | done | failed"
        uuid quest_giver_id FK "required"
        jsonb reward
    }
    QUEST_LOCATION {
        uuid quest_id PK,FK
        uuid location_id PK,FK
    }
    SCENE {
        uuid id PK
        int number
        uuid location_id FK
        text summary "required on end"
        timestamptz ended_at
    }
    ENCOUNTER {
        uuid id PK
        uuid scene_id FK
        bool active
        jsonb combat_snapshot "turn order, active character, used actions; null after end"
    }
    SCENE_CREATURE_LOG {
        uuid scene_id PK,FK
        uuid creature_id PK,FK
        text outcome PK "killed | fled | spared | tamed | promoted"
        int count
        text note
    }
